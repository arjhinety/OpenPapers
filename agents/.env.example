# Any OpenAI-compatible endpoint. Examples:
#   OpenAI:     OPA_BASE_URL=https://api.openai.com/v1                              OPA_MODEL=gpt-5.4-mini
#   Gemini:     OPA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai OPA_MODEL=gemini-3-flash-preview
#   Anthropic:  OPA_BASE_URL=https://api.anthropic.com/v1                            OPA_MODEL=claude-sonnet-5
#   OpenRouter: OPA_BASE_URL=https://openrouter.ai/api/v1                            OPA_MODEL=deepseek/deepseek-v4.1-flash
#   Ollama:     OPA_BASE_URL=http://localhost:11434/v1                               OPA_MODEL=qwen3.5:9b
# Leave OPA_BASE_URL empty to use a native LangChain id such as "anthropic:claude-sonnet-5"
# (requires `pip install langchain langchain-anthropic`).
OPA_BASE_URL=https://api.cline.bot/api/v1
OPA_MODEL=cline-pass/deepseek-v4.1-flash
# Name of the env var holding the key (keeps secrets out of this file), or set OPA_API_KEY directly.
OPA_API_KEY_ENV=CLINE_API_KEY
# 1 for reasoning models: no temperature, strips <think> blocks.
OPA_REASONING=1
# Optional per-role model overrides: planner researcher analyst writer critic patcher verifier
# OPA_MODEL_CRITIC=...
OPA_LLM_CONCURRENCY=4
OPA_MCP_CONCURRENCY=2

# Independent grounding checkers (uv sync --extra grounding): auto | off | lettucedetect,minicheck
# auto = LettuceDetect only; use "lettucedetect,minicheck" for a second vote (~1.5 GB more RAM)
OPA_GROUNDING=auto
# OPA_GROUNDING_THRESHOLD=0.5
# OPA_LETTUCE_MODEL=KRLabsOrg/lettucedect-base-modernbert-en-v1
# OPA_MINICHECK_MODEL=roberta-large

# Langfuse tracing (uv sync --extra tracing); tracing is off unless both keys are set.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
