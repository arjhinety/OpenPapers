{
  "name": "openpapers",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "description": "Provenance-first MCP server for reproducible LLM/ML research",
  "mcpName": "io.github.arrogance231/openpapers",
  "repository": {
    "type": "git",
    "url": "https://github.com/arrogance231/OpenPapers.git"
  },
  "homepage": "https://github.com/arrogance231/OpenPapers#readme",
  "bugs": {
    "url": "https://github.com/arrogance231/OpenPapers/issues"
  },
  "keywords": [
    "mcp",
    "research",
    "scholarly",
    "provenance",
    "llm",
    "machine-learning"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/mcp/server.js",
    "dev": "tsx src/mcp/server.ts",
    "test": "node --no-warnings ./node_modules/vitest/vitest.mjs run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "architecture-check": "node scripts/verify-architecture.mjs",
    "check": "npm run lint && npm run architecture-check && npm run build && npm test",
    "eval:baseline": "npm run build && node evals/runners/run-baseline.mjs",
    "eval:research": "npm run build && node evals/runners/run-research-tasks.mjs",
    "eval:pdf": "npm run build && node evals/runners/run-pdf.mjs",
    "eval:providers": "npm run build && node --env-file-if-exists=.env evals/runners/run-provider-degradation.mjs",
    "eval:validate-real": "node evals/validate-real-source.mjs",
    "eval:validate-real-v2": "node evals/validate-real-source-v2.mjs",
    "eval:acquire-real-v2": "node scripts/acquire-real-source-v2.mjs",
    "eval:real-v2-dev": "npm run eval:acquire-real-v2 -- --split=development && npm run build && node --env-file-if-exists=.env evals/runners/run-real-source-v2.mjs",
    "eval:real-v2-holdout": "node --env-file-if-exists=.env evals/runners/run-real-source-v2.mjs --split=holdout --allow-holdout",
    "eval:validate-real-v3": "node evals/validate-real-source-v3.mjs",
    "eval:acquire-real-v3": "node scripts/acquire-real-source-v3.mjs",
    "eval:real-v3-dev": "npm run eval:acquire-real-v3 -- --split=development && npm run build && node --env-file-if-exists=.env evals/runners/run-real-source-v3-wrapper.mjs",
    "eval:real-v3-holdout": "node --env-file-if-exists=.env evals/runners/run-real-source-v3-wrapper.mjs --split=holdout --allow-holdout",
    "eval:validate-real-v4": "node evals/validate-real-source-v4.mjs",
    "eval:acquire-real-v4": "node scripts/acquire-real-source-v4.mjs",
    "eval:real-v4-dev": "npm run eval:acquire-real-v4 -- --split=development && npm run build && node --env-file-if-exists=.env evals/runners/run-real-source-v4-wrapper.mjs",
    "eval:real-v4-holdout": "node --env-file-if-exists=.env evals/runners/run-real-source-v4-wrapper.mjs --split=holdout --allow-holdout",
    "eval:acquire-real": "node scripts/acquire-real-source.mjs",
    "eval:real-dev": "npm run eval:acquire-real -- --split=development && npm run build && node --env-file-if-exists=.env evals/runners/run-real-source.mjs",
    "eval:real-holdout": "node --env-file-if-exists=.env evals/runners/run-real-source.mjs --split=holdout --allow-holdout",
    "eval:pdf-real": "node evals/runners/run-real-pdf.mjs",
    "eval:fact-schema": "node evals/runners/run-scoped-fact-baseline.mjs --validate-only",
    "eval:fact-schema-v52": "node evals/runners/run-scoped-fact-baseline.mjs --validate-only --dataset=evals/datasets/research-facts-v5-2-development.json",
    "eval:fact-baseline": "npm run build && node evals/runners/run-scoped-fact-baseline.mjs",
    "eval:fact-lopo": "npm run build && node evals/runners/run-scoped-fact-lopo.mjs",
    "eval:fact-real-pdf": "npm run build && node evals/runners/run-real-pdf-fact-baseline.mjs",
    "eval:fact-real-pdf-lopo": "npm run build && node evals/runners/run-real-pdf-fact-lopo.mjs",
    "eval:fact-fn-trace": "npm run build && node evals/runners/run-v5-3-fn-trace.mjs",
    "eval:span-recovery": "npm run build && node evals/runners/run-v5-3-1-span-recovery.mjs",
    "eval:holdout": "npm run build && node evals/runners/run-retrieval-holdout.mjs",
    "test:postgres": "npm run build && node scripts/postgres-integration.mjs",
    "package:dry-run": "npm pack --dry-run",
    "prepack": "npm run build",
    "eval:live-search": "npm run build && node --env-file-if-exists=.env evals/runners/run-live-search-reliability.mjs",
    "test:live": "npm run build && node --env-file-if-exists=.env evals/runners/run-live-search-reliability.mjs --strict",
    "test:docker": "node scripts/docker-e2e.mjs",
    "test:e2e": "npm run build && npx vitest run tests/e2e/ tests/tools-matrix.test.ts",
    "verify": "npm run check && npm run test:e2e",
    "test:coverage": "npx vitest run --coverage"
  },
  "bin": {
    "openpapers": "dist/mcp/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "CHANGELOG.md",
    "docs",
    ".env.example"
  ],
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "pg": "^8.23.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
